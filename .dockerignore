# Build context for the API image (repo root). Keep it small and secret-free.
node_modules
**/node_modules

# Build output — regenerated inside the image.
api/build
web/dist
web/build

# Local state and secrets — env vars are injected by the host.
.env
**/.env
api/logs
**/*.log

# Editor / agent / VCS noise.
.git
.github
.workbuddy-ai
.hormachuelos
.vscode
.idea
