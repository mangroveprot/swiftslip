# ─────────────────────────────────────────────────────────────────────────────
# SwiftSlip web environment  (cp .env.example .env)
#
# The web app talks to the API only through this one variable. Only `VITE_*`
# variables are bundled into browser JS — never put a secret here.
# Secrets (Supabase, SESSION_SECRET, Gemini…) live in api/.env.
# ─────────────────────────────────────────────────────────────────────────────

# Base URL of the API, including the /api prefix.
#   - Leave blank in development: the Vite dev server proxies /api → http://localhost:9095.
#   - Production, API on its own domain: https://api.example.com/api
#     (then add this site's origin to CORS_ORIGIN in api/.env).
#   - Production, API behind the same domain (reverse proxy /api): leave blank.
VITE_API_URL=

# Optional: where the dev/preview proxy sends /api (default http://localhost:9095).
# API_DEV_TARGET=http://localhost:9095
