# ─────────────────────────────────────────────────────────────────────────────
# SwiftSlip API environment
#
#   npm run setup      creates api/.env from this file (never overwrites it)
#
# Every variable is read in exactly ONE place: src/core/config/index.ts.
# To add or rename one, change that file and this one — nothing else.
# `.env` is git-ignored. Never commit real values.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=9095
TIME_ZONE=Asia/Manila

# Origin(s) allowed to call the API from a browser, comma-separated.
CORS_ORIGIN=http://localhost:8080

# Largest JSON body accepted (attachments are uploaded as base64 JSON).
BODY_LIMIT=15mb

# Reverse proxies in front of the API (0 = none, 1 = one proxy such as nginx or
# Cloudflare). Set it so the sign-in throttle sees the real visitor IP.
TRUST_PROXY=0

# Folder with the built web app. In Docker the image sets it to /app/web/dist so
# this one service serves the website AND the API. Leave blank in development
# (Vite serves the web app on :8080 and proxies /api here).
# WEB_DIST=../web/dist

# Rate limit per IP: window in milliseconds, and max requests inside it.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# ── Sign-in cookie ──────────────────────────────────────────────────────────
# Signs the httpOnly session cookie. SECRET, at least 32 characters:
#   openssl rand -hex 32
# Changing it signs everyone out.
SESSION_SECRET=
SESSION_COOKIE_NAME=swiftslip-session
# How long a login lasts (seconds). 43200 = 12 hours.
SESSION_MAX_AGE_SECONDS=43200

# ── Supabase ────────────────────────────────────────────────────────────────
# Dashboard → Project Settings → API
SUPABASE_URL=
# The "service_role" key. SECRET: server-only, bypasses Row Level Security.
SUPABASE_SERVICE_ROLE_KEY=

# ── Gemini (AI helpers + biometric import) ──────────────────────────────────
# Google AI Studio key. Leave empty to switch every AI feature off.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# ── RGC asset inventory (separate Postgres database) ────────────────────────
# Direct connection string, URL-encoded: postgresql://user:pass@host:5432/db
# Leave empty to switch the inventory endpoints off (they answer 503).
RGC_INVENTORY_DATABASE_URL=

# ── File storage: Backblaze B2 (optional, future features) ──────────────────
# A SECOND storage backend beside the Supabase Storage attachments, which keep
# working untouched. See STORAGE_GUIDE.md. Leave the three credential/endpoint
# values empty to switch the /files endpoints off (they answer 503).
#
# Public read front door (Cloudflare Worker). Only for files meant to be
# public; private files are served through short-lived presigned GET URLs.
# FILE_BASE_URL=https://swiftslip-cloudflare.mangroveprot.workers.dev
#
# B2 S3 API — SECRET, backend only. Never put these in a VITE_* variable.
# e.g. B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
B2_ENDPOINT=
B2_REGION=us-west-004
B2_BUCKET=swiftslip
B2_UPLOAD_KEY_ID=
B2_UPLOAD_APP_KEY=
#
# Upload limits for the B2 store. MAX_UPLOAD_MB cannot exceed 10 (the body
# arrives as base64 JSON; BODY_LIMIT must hold it). ALLOWED_MIME is a
# comma-separated list; types the upload checker cannot verify are refused.
MAX_UPLOAD_MB=10
ALLOWED_MIME=image/jpeg,image/png,image/webp,application/pdf

# ── Storage settings (Admin Panel → Settings → Storage) ─────────────────────
# Plan limits shown on the Storage page and used by the "Supabase first, B2
# when full" rule. The Supabase bucket default matches the bucket the app has
# always used; only set it if you rename the bucket.
SUPABASE_STORAGE_BUCKET=swiftslip
SUPABASE_STORAGE_LIMIT_MB=1024
B2_STORAGE_LIMIT_MB=10240

# When Supabase free space falls below this % of the limit, new uploads move
# to B2 under the "supabase-first" rule (1–50).
STORAGE_MIN_FREE_PERCENT=1

# How long the Storage page caches its usage numbers (seconds), and how young
# an object must be to be spared from the orphan cleanup (a just-finished
# upload may not have its database row yet).
STORAGE_USAGE_CACHE_SECONDS=60
STORAGE_ORPHAN_GRACE_SECONDS=600

# Optional dashboard links shown on the Storage page. The Supabase one is
# derived from SUPABASE_URL when unset.
# SUPABASE_STORAGE_DASHBOARD_URL=
B2_DASHBOARD_URL=https://secure.backblaze.com/b2_buckets.htm
