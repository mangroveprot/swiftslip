# ─────────────────────────────────────────────────────────────────────────────
# SwiftSlip API environment
#
#   npm run setup      creates api/.env from this file (never overwrites it)
#
# Every variable is read in exactly ONE place: src/core/config/index.ts.
# To add or rename one, change that file and this one — nothing else.
# `.env` is git-ignored. Never commit real values.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=9095
TIME_ZONE=Asia/Manila

# Origin(s) allowed to call the API from a browser, comma-separated.
CORS_ORIGIN=http://localhost:8080

# Largest JSON body accepted (attachments are uploaded as base64 JSON).
BODY_LIMIT=15mb

# Reverse proxies in front of the API (0 = none, 1 = one proxy such as nginx or
# Cloudflare). Set it so the sign-in throttle sees the real visitor IP.
TRUST_PROXY=0

# Folder with the built web app. In Docker the image sets it to /app/web/dist so
# this one service serves the website AND the API. Leave blank in development
# (Vite serves the web app on :8080 and proxies /api here).
# WEB_DIST=../web/dist

# Rate limit per IP: window in milliseconds, and max requests inside it.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# ── Sign-in cookie ──────────────────────────────────────────────────────────
# Signs the httpOnly session cookie. SECRET, at least 32 characters:
#   openssl rand -hex 32
# Changing it signs everyone out.
SESSION_SECRET=
SESSION_COOKIE_NAME=swiftslip-session
# How long a login lasts (seconds). 43200 = 12 hours.
SESSION_MAX_AGE_SECONDS=43200

# ── Supabase ────────────────────────────────────────────────────────────────
# Dashboard → Project Settings → API
SUPABASE_URL=
# The "service_role" key. SECRET: server-only, bypasses Row Level Security.
SUPABASE_SERVICE_ROLE_KEY=

# ── Gemini (AI helpers + biometric import) ──────────────────────────────────
# Google AI Studio key. Leave empty to switch every AI feature off.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# ── RGC asset inventory (separate Postgres database) ────────────────────────
# Direct connection string, URL-encoded: postgresql://user:pass@host:5432/db
# Leave empty to switch the inventory endpoints off (they answer 503).
RGC_INVENTORY_DATABASE_URL=
