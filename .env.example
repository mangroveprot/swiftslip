# ─────────────────────────────────────────────────────────────────────────────
# SwiftSlip environment
#
#   cp .env.example .env      then fill in the values below.
#
# Every variable here is read in exactly ONE place: src/config/env.server.ts.
# To add/rename a variable, change that file and this one — nothing else.
# `.env` is git-ignored. Never commit real values.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase ────────────────────────────────────────────────────────────────
# Dashboard → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co

# The "service_role" key. SECRET: server-only, bypasses Row Level Security.
# Never prefix it with VITE_ — that would bundle it into browser JS.
SUPABASE_SERVICE_ROLE_KEY=

# ── Sessions ────────────────────────────────────────────────────────────────
# Signs/encrypts the login cookie. Must be 32+ characters.
# Generate one with:  openssl rand -hex 32
SESSION_SECRET=

# ── Optional: AI biometric-log import (Google Gemini) ───────────────────────
# Key from https://aistudio.google.com/app/apikey — leave blank to disable the feature.
GEMINI_API_KEY=
# Defaults to the model set in src/config/app.ts when left blank.
GEMINI_MODEL=

# ── Optional: database migrations only (drizzle-kit) ────────────────────────
# Postgres connection string. Not used by the running app.
# DATABASE_URL=postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres
